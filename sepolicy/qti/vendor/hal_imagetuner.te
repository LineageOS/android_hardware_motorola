type hal_imagetuner_default, domain;
hal_server_domain(hal_imagetuner_default, hal_imagetuner)

type hal_imagetuner_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_imagetuner_default)

allow hal_imagetuner_default hal_imagetuner_aidl_service:service_manager { add find };

binder_call(hal_imagetuner_default, servicemanager)

r_dir_file(hal_imagetuner_default, vendor_persist_camera_file)

allow hal_imagetuner_default vendor_camera_data_file:dir create_dir_perms;
allow hal_imagetuner_default vendor_camera_data_file:file create_file_perms;
