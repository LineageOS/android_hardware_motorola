package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "lineageos.motorola.face.bridge-aidl",
    owner: "lineageos",
    vendor_available: true,
    srcs: ["aidl/lineageos/motorola/face/bridge/*.aidl"],
    local_include_dir: "aidl",
    stability: "vintf",
    frozen: false, // freeze with `m lineageos.motorola.face.bridge-aidl-freeze-api` if your tree requires it
    backend: {
        ndk: { enabled: true },
        java: { enabled: true, platform_apis: true },
        cpp: { enabled: false },
    },
}

// Opt-in entry point: PRODUCT_PACKAGES += lineageos.motorola.face.bridge
// (pulls in the vendor HAL daemon + the system_ext bridge app; sepolicy is separate, see README)
phony {
    name: "lineageos.motorola.face.bridge",
    required: [
        "android.hardware.biometrics.face-service.motorola",
        "MotoFaceBridge",
        "moto-face-framework",
        "moto-face-framework.xml",
        "moto-core_services.xml",
        "android.hardware.biometrics.face-service.motorola.xml",
    ],
}
