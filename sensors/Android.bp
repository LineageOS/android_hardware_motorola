cc_library_shared {
    name: "sensors.moto_ext",
    defaults: ["hidl_defaults"],
    srcs: [
        "Sensor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.moto_ext\"",
    ] + select(soong_config_variable("moto_sensors", "udfps"), {
        false: [],
        default: ["-DENABLE_UDFPS"],
    }) + select(soong_config_variable("moto_sensors", "double_tap"), {
        false: [],
        default: ["-DENABLE_DOUBLE_TAP"],
    }),
    vendor: true,
}
