aidl_interface {
    name: "com.motorola.hardware.biometric.fingerprint",
    vendor_available: true,
    srcs: ["com/motorola/hardware/biometric/fingerprint/*.aidl"],
    stability: "vintf",
    owner: "motorola",

    backend: {
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
        {
            version: "3",
            imports: [],
        },

    ],

}

aidl_interface {
    name: "com.motorola.hardware.biometric.face.bridge-aidl",
    vendor_available: true,
    srcs: ["com/motorola/hardware/biometric/face/bridge/*.aidl"],
    stability: "vintf",
    owner: "motorola",
    frozen: false, // freeze with `m com.motorola.hardware.biometric.face.bridge-aidl-freeze-api` if your tree requires it
    backend: {
        ndk: { enabled: true },
        java: { enabled: true, platform_apis: true },
        cpp: { enabled: false },
    },
}
