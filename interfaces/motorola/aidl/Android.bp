    stability: "vintf",
    owner: "motorola",

    backend: {
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },

    ],
    frozen: true,
}
