cc_defaults {
    name: "libudfpshandler_moto_defaults",
    shared_libs: [
        "com.motorola.hardware.biometric.fingerprint@1.0",
        "libbase",
        "libhidlbase",
        "libutils",
    ],
    static_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
    ],
    header_libs: [
        "generated_kernel_headers",
        "motofingerprint_headers",
    ],
    vendor: true,
}

cc_library {
    name: "libudfpshandler_moto",
    defaults: ["libudfpshandler_moto_defaults"],
    srcs: ["UdfpsHandlerMoto.cpp"],
    shared_libs: [
        "com.motorola.hardware.biometric.fingerprint@1.0",
    ],
}

cc_library {
    name: "libudfpshandler_moto_egistec",
    defaults: ["libudfpshandler_moto_defaults"],
    srcs: ["UdfpsHandlerEgistec.cpp"],
    shared_libs: [
        "vendor.egistec.hardware.fingerprint@4.0",
    ],
}

cc_library {
    name: "libudfpshandler_moto_goodix",
    defaults: ["libudfpshandler_moto_defaults"],
    srcs: ["UdfpsHandlerGoodix.cpp"],
    shared_libs: [
        "vendor.goodix.hardware.biometrics.fingerprint@2.1",
    ],
}
