cc_library {
    name: "libudfpshandler_moto",
    vendor: true,
    cflags: select(soong_config_variable("moto_udfps", "screen_wake_delay"), {
        any @ flag_val: ["-DSCREEN_WAKE_DELAY=" + flag_val],
        default: ["-DSCREEN_WAKE_DELAY=200"],
    }),
    srcs: ["UdfpsHandlerMoto.cpp"],
    shared_libs: [
        "android.hardware.biometrics.fingerprint@2.1",
        "com.motorola.hardware.biometric.fingerprint@1.0",
        "libbase",
        "libhidlbase",
        "libutils",
    ],
    header_libs: [
        "generated_kernel_headers",
        "libudfpshandler_headers",
    ],
}
